[Unit]
Description=lux, a Lua-based web and application server.
DefaultDependencies=no
After=network.target

[Service]
Type=simple
ExecStart=__PREFIX__/bin/lxsrv --start --port 443 --user __SRVUSER__ --group __SRVGROUP__ --configuration __WWWROOT__/config.lua --logfile __LOGDIR__/lxlog.db --protocol=https
Restart=on-failure
RestartSec=20s

[Install]
WantedBy=multi-user.target
