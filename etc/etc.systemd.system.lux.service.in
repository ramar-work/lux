[Unit]
Description=lux, a Lua-based web and application server.
DefaultDependencies=no
After=network.target

[Service]
Type=simple
ExecStart=@prefix@/bin/lxsrv --start --port @wwwport@ --user @srvuser@:@srvgroup@ --configuration @wwwroot@/config.lua --logfile @logdir@/lxlog.db -W @write_size@ --protocol=@protocol@
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
