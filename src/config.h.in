 *
 * ------------------------------------------- */

/* Do not edit this line: needed for INT_MAX comparison */
#include <limits.h>

/* Define the address where bug reports for this package should be sent. */
#define PACKAGE_BUGREPORT "ramar@ramarcollins.com"

/* Define the full name of this package. */
#define PACKAGE_NAME "@PACKAGE_NAME@"

/* Define the version of this package. */
#define PACKAGE_VERSION "@PACKAGE_VERSION@"

/* Define the full name and version of this package. */
#define PACKAGE_STRING "@PACKAGE_NAME@ @PACKAGE_VERSION@"

/* Define the symbol short name of this package. */
#define PACKAGE_TARNAME "@PACKAGE_NAME@"

/* Define the home page for this package. */
#define PACKAGE_URL "https://ramarcollins.com"

/* Define a key name for response table */
#define CKEY_RESPONSE "response"

/* Define a key name for shadow directory */
#define CKEY_SHADOW "shadow"

/* How long should each client be allowed to persist? */
#ifndef CLIENT_REQUEST_TIMEOUT
 #define CLIENT_REQUEST_TIMEOUT 5
#endif

/* Default status for too many connections */
#ifndef LOAD_TOO_HIGH_STATUS
 #define LOAD_TOO_HIGH_STATUS 503
#endif

/* Where are the default htdocs? */
#ifndef HTDOCS_DIR
 #define HTDOCS_DIR "@wwwroot@"
#endif

/* Set a default port */
#ifndef DEFAULT_WWW_PORT
 #define DEFAULT_WWW_PORT @wwwport@
#endif

/* Check for misconfigurations with default port */
#if ( DEFAULT_WWW_PORT > 65535 ) || ( DEFAULT_WWW_PORT < 0 ) 
 #error "Port specified (" DEFAULT_WWW_PORT ") is invalid."
#endif

/* How often should a process poll for new data? */
#ifndef POLL_INTERVAL
 #define POLL_INTERVAL @poll_interval@
#endif

#if POLL_INTERVAL < 0
 #error "Poll interval specified (" DEFAULT_WWW_PORT ") is invalid."
#endif

/* Default read buffer size */
#ifndef ZHTTP_PREAMBLE_SIZE
 #define ZHTTP_PREAMBLE_SIZE @preamble_size@
#endif

/* Default read buffer size */
#ifndef CTX_READ_SIZE
 #define CTX_READ_SIZE @read_size@
#endif

#if CTX_READ_SIZE < 0
 #error "Context read size specified (" CTX_READ_SIZE ") is invalid."
#endif

/* Default file receive size (8MB) */
#ifndef CTX_READ_MAX
 #define CTX_READ_MAX @read_max@
#endif

#if CTX_READ_MAX < 0
 #error "Context read maximum specified (" CTX_READ_MAX ") is invalid."
#endif

/* Default write sink size (1MB) */
#ifndef CTX_WRITE_SIZE
 /* #define CTX_WRITE_SIZE 1048576 */
 #define CTX_WRITE_SIZE @write_size@
#endif

#if CTX_WRITE_SIZE < 0
 #error "Context write size specified (" CTX_WRITE_SIZE ") is invalid."
#endif

/* Default stack size of each new thread  */
#ifndef STACK_SIZE
 #define STACK_SIZE @stack_size@
#endif

#if STACK_SIZE < PTHREAD_STACK_MIN
 #error "Defined stack size: " STACK_SIZE " is less than system minimum, " PTHREAD_STACK_MIN "." \
	"Please define a size greater than this."
#endif

/* Default thread limit */
#ifndef LUX_MAX_THREADS
 #define LUX_MAX_THREADS @max_threads@
#endif

#if LUX_MAX_THREADS < 0
 #error "Maximum thread count specified (" LUX_MAX_THREADS ") is invalid."
#endif

/* How many clients until the main thread cleans up */
#ifndef CLIENT_MAX_SIMULTANEOUS
 #define CLIENT_MAX_SIMULTANEOUS @max_simultaneous_connections@
#endif

#if CLIENT_MAX_SIMULATANEOUS < 0
 #error "Maximum simultaneous connections count specified (" CLIENT_MAX_SIMULATANEOUS ") is invalid."
#endif

/* Default max connection count, when this is reached, we clean up */
#ifndef LUX_MAX_CONN_COUNT
 #define LUX_MAX_CONN_COUNT @max_conn_count@
#endif

#if LUX_MAX_CONN_COUNT < 0
 #error "Maximum connection count ( " LUX_MAX_CONN_COUNT " ) cannot be negative."
#endif

#if LUX_MAX_CONN_COUNT > INT_MAX
 #error "Maximum connection count ( " LUX_MAX_CONN_COUNT " ) cannot exceed " INT_MAX " (INT_MAX)."
#endif

#if LUX_MAX_THREADS < LUX_MAX_CONN_COUNT
 #error \
	"Defined maximum thread count (" LUX_MAX_THREADS ") is less than maximum " \
	"simultaneous connections (" LUX_MAX_CONN_COUNT ").  " \
	"Please define a size greater than " LUX_MAX_CONN_COUNT "."
#endif

/* Default listener backlog (default = 2x MAX_CONN_COUNT) */
#ifndef LUX_BACKLOG
 #define LUX_BACKLOG @socket_backlog@
#endif

/* Default logging directory */
#ifndef ERROR_LOGDIR
 #define ERROR_LOGDIR "@logdir@"
#endif

/* Default error log file location */
#ifndef ERROR_LOGFILE
 #define ERROR_LOGFILE ERROR_LOGDIR "@default_error_file_name@"
#endif

/* Default error log database location */
#ifndef ERROR_LOGDB
 #define ERROR_LOGDB ERROR_LOGDIR "/log.db"
#endif

/* Enable XML support */
#if @with_xml@
 #define INCLUDE_XML_SUPPORT
#endif

/* Enable JSON support */
#if @with_json@
 #define INCLUDE_JSON_SUPPORT
#endif

/* Enable msgpack support */
#if @with_msgpack@
 #define INCLUDE_MSGPACK_SUPPORT
#endif

/* Deactivate TLS support */
#if @disable_tls@
 #define DISABLE_TLS
#endif

/* Deactivate SQLite3 interface */
#if @disable_sqlite3@
 #define NOSQLITE_H
#endif

/* Deactivate MySQL interface */
#if @disable_mysql@
 #define NOMYSQL_H
#endif

/* Deactivate PostgreSQL interface */
#if @disable_pgsql@
 #define NOPGSQL_H
#endif

/* Deactivate SQL Server interface */
#if @disable_sqlserver@
 #define NOSQLSVR_H
#endif

/* Deactivate Oracle interface */
#if @disable_oracle@
 #define NOORACLE_H
#endif

/* Enable C filter */
#if @include_filter_c@
 #define USEFILTER_C
#endif

/* Enable static filter */
#if @include_filter_static@
 #define USEFILTER_STATIC
#endif

/* Enable echo filter */
#if @include_filter_echo@
 #define USEFILTER_ECHO
#endif

/* Enable Lua filter */
#if @include_filter_lua@
 #define USEFILTER_LUA
#endif

/* Define an alternative configuration directory */
#ifndef CONFDIR
 #define CONFDIR "@confdir@/"
#endif

/* Define an alternative share directory */
#ifndef SHAREDIR
 #define SHAREDIR "@sharedir@/"
#endif

/* Define the path to the session database. */
#ifndef SESSION_DB_PATH
 #define SESSION_DB_PATH CONFDIR "lux.db"
#endif

/* Use sendfile or not */
#if @include_sendfile@
 #define SENDFILE_ENABLED
#endif

/* Define to 1 if you have the `dl' library (-ldl). */
/* #define HAVE_LIBDL 1 */

/* Define an optionally larger read limit for the fs module. */
#ifndef LUA_FS_READ_LIMIT
 #define LUA_FS_READ_LIMIT 4194304
#endif

#if LUA_FS_READ_LIMIT < 0
 #error "LUA_FS_READ_LIMIT (" LUA_FS_READ_LIMIT ") cannot be negative."
#endif

#if LUA_FS_READ_LIMIT > INT_MAX
 #error "LUA_FS_READ_LIMIT (" LUA_FS_READ_LIMIT ") exceeds max size: " INT_MAX "."
#endif
