# @configure_input@
## --------------------------------------------------------- ##
## lux makefile
## 
## @summary
## Contains all the targets necessary to assemble
## Hypno on most machines. 
##
## @author
## Copyright 2022-2026 Antonio R. Collins II dba rwk apps
## --------------------------------------------------------- ##
BINNAME = @PACKAGE_NAME@
VERSION = @PACKAGE_VERSION@
prefix = @prefix@
exec_prefix = @exec_prefix@
BINDIR = @bindir@
LOGDIR = @logdir@
CONFDIR = @confdir@
DATADIR = @sharedir@
WWWROOT = @wwwroot@
WWWPORT = @wwwport@
SVCPATH = @svcpath@
srcdir = @srcdir@
VPATH = @srcdir@
SRVUSER = @srvuser@
SRVGROUP = @srvgroup@
UNITFILE = @unit_file@
LUAVER = 5.4.4
GNUTLSVER = 3.6.16
IFLAGS = -Ivendor -Iinclude
LDFLAGS = @ld_flags@
DEBUGFLAGS = @debug_flags@
MODEL = HTHREAD_H
ASAN_OPTIONS = log_path=asan.log
BASEFLAGS = \
	-Wall \
	-Werror \
	-Wno-unused \
	-Wno-strict-overflow \
	-Wno-unused-result \
	-Wno-strict-aliasing
GCCFLAGS = $(BASEFLAGS) \
	-Wno-format-truncation \
	-Wno-return-local-addr \
	-O3 $(IFLAGS)
CLANGFLAGS = $(BASEFLAGS) \
	-O3 $(IFLAGS)
INITMETHOD = @initsys@
INITEXAMPLES = @examples@
CFLAGS = $(GCCFLAGS) $(DEBUGFLAGS)
#CFLAGS = $(CLANGFLAGS) $(DEBUGFLAGS)
CC = @cc@
SRC = \
	@srcdir@/vendor/zrender.c \
	@srcdir@/vendor/ztable.c \
	@srcdir@/vendor/zdb.c \
	@srcdir@/vendor/zwalker.c \
	@srcdir@/vendor/zhttp.c \
	@srcdir@/vendor/zmime.c \
	@srcdir@/vendor/zjson.c \
	@srcdir@/vendor/router.c \
	@srcdir@/src/configs.c \
	@srcdir@/src/lua.c \
	@srcdir@/src/util.c \
	@srcdir@/src/loader.c \
	@srcdir@/src/logging/log.c \
	@srcdir@/src/lua/lib.c \
	@srcdir@/src/lua/db.c \
	@srcdir@/src/lua/lua.c \
	@srcdir@/src/lua/json.c \
	@srcdir@/src/lua/rand.c \
	@srcdir@/src/lua/fs.c \
	@srcdir@/src/lua/http.c \
	@srcdir@/src/lua/hash.c \
	@srcdir@/src/lua/enc.c \
	@srcdir@/src/lua/dec.c \
	@srcdir@/src/ctx/ctx-http.c \
	@srcdir@/src/ctx/ctx-https.c \
	@srcdir@/src/server/server.c \
 	@srcdir@/src/server/single.c \
 	@srcdir@/src/server/multithread.c \
 	@srcdir@/src/filters/shared.c \
 	@srcdir@/src/filters/filter-echo.c \
	@srcdir@/src/filters/filter-lua.c \
	@srcdir@/src/filters/filter-static.c \
	@srcdir@/src/cli/lxcommon.c

#	@srcdir@/src/xml.c
#	@srcdir@/src/filters/filter-dirent.c 

OBJ = ${SRC:.c=.o}
DEPS = @objdeps@
UNAME = $(shell uname)
DOMAIN = @default_domain@
DISTDIR = $(BINNAME)-$(VERSION)
FILES = \
	configure \
	config.guess \
	config.sub \
	install-sh \
	LICENSE \
	Makefile.in \
	mk/tests.mk \
	mk/docs.mk \
	README.md


# Include any temporary targets that should run first
-include tmp.mk

# main - Compiles all code needed to get lux running
main: server cli conf package

# server - Builds the server only
server: $(DEPS) $(OBJ)
	-@test -d $(srcdir)/bin/ || mkdir $(srcdir)/bin/
	$(CC) $(CFLAGS) $(srcdir)/src/cli/lxsrv.c -o $(srcdir)/bin/lxsrv $(OBJ) $(DEPS) $(LDFLAGS) -larchive

# package - Builds lxpkg only
package: $(DEPS) $(OBJ)
	#	-@test -d $(srcdir)/bin/ || mkdir $(srcdir)/bin/
	#	$(CC) $(CFLAGS) $(srcdir)/src/cli/lxpkg.c -o $(srcdir)/bin/lxpkg $(OBJ) $(DEPS) $(LDFLAGS) -larchive

# cli - Builds admin tool only
# FIXME: $(DEPS) will result in wasted space here.  TLS, for example, is not used
cli: $(DEPS) $(OBJ) 
	-@test -d $(srcdir)/bin/ || mkdir $(srcdir)/bin/
	$(CC) $(CFLAGS) $(srcdir)/src/cli/lxcli.c -o $(srcdir)/bin/lxcli $(OBJ) $(DEPS) $(LDFLAGS) -larchive

# conf - Builds lxconf only
conf: $(DEPS) $(OBJ)
	-@test -d $(srcdir)/bin/ || mkdir $(srcdir)/bin/
	$(CC) $(CFLAGS) $(srcdir)/src/cli/lxconf.c -o $(srcdir)/bin/lxconf $(OBJ) $(DEPS) $(LDFLAGS) -larchive

# debug - Builds code with debugging flags on (need logic for if CC == clang)
debug: CFLAGS += -g -O0 -DDEBUG_H
debug: main
	@printf '' > /dev/null

# clang/safe - Builds code without debugging symbols or flags, but trap and dump core on ASAN errors
clang: CC = clang
clang: CFLAGS = $(CLANGFLAGS) -O3 -fsanitize-undefined-trap-on-error -fsanitize=address
clang: main
	@printf '' > /dev/null

# clangdebug - Builds code with debugging flags on and ASAN
clangdebug: CFLAGS = $(CLANGFLAGS) -g -O0 -fsanitize=address -fsanitize-undefined-trap-on-error -fno-omit-frame-pointer -DDEBUG_H
clangdebug: CC = clang
clangdebug: main
	@printf '' > /dev/null

# install - Runs a full system install
install: filesystem-install $(INITMETHOD)-install $(INITEXAMPLES)-install
	@printf '' > /dev/null

# filesystem-install - Installs targets to $prefix/{bin,share} and /var/lib
filesystem-install:
	#echo 'Running filesystem-install...'
	install -d $(exec_prefix)/bin
	install -m 0755 $(srcdir)/bin/* $(exec_prefix)/bin/
	# When an external library is completed, this can go here
	#install -d $(exec_prefix)/lib
	#install -m 0755 $(srcdir)/lib/* $(exec_prefix)/lib/
	# Install the shared readonly files directory
	install -d $(DATADIR)
	find $(srcdir)/share/ -maxdepth 1 -type f | \
		xargs -IFF sh -c 'install -m 644 FF $(DATADIR)/'
	# Install the configuration file (and a directory to keep it manageable)
	install -d $(CONFDIR)/
	install -m 644 $(srcdir)/etc/etc.lux.lux.lua $(CONFDIR)/config.lua
	# Install the logging directory
	install -d $(LOGDIR)/ && chown $(SRVUSER):$(SRVGROUP) $(LOGDIR)/
	# Install the server configuration again?
	-install -d $(WWWROOT)/ && chown $(SRVUSER):$(SRVGROUP) $(WWWROOT)/
	# Copy if no files exist
	test -f $(WWWROOT)/config.lua || cp $(srcdir)/share/config.server.lua $(WWWROOT)/config.lua

# examples-install - Install examples for new users
examples-install:
	-test -f $(WWWROOT)/config.lua && \
		cp -r $(srcdir)/www/demos/* $(WWWROOT)/ && \
		sed -i 's;wwwroot = "example";wwwroot = "$(WWWROOT)";' $(WWWROOT)/config.lua

# lib-install - Create and install library directory for extensions
lib-install:
	#echo 'Running lib-install...'
	install -d /var/lib/$(BINNAME)
	install -m 0755 $(srcdir)/lib/* /var/lib/$(BINNAME)/
	chown -R $(SRVUSER):$(SRVGROUP) /var/lib/$(BINNAME)/

# none-install - Installs (you guessed it) nothing
none-install: 

# launchd-install - Installs launchd files for Macs
launchd-install: 

# sysv-install - Installs launchd files for Macs
sysv-install: 

# bsdinit-install - Installs rc.d files for BSD systems 
bsdinit-install: 

# systemd-install - Installs systemd on Linux systems
systemd-install:
	cp $(UNITFILE) $(SVCPATH)/$(BINNAME).service

#}" $(srcdir)/etc/etc.systemd.system.lux.service > $(SVCPATH)/$(BINNAME).service
# cygwin-install - Installs lux as a service suitable for use with Cygwin 
cygwin-install:
	cygstart --action=runas cygrunsrv --install lux --user $(USER) -p /usr/local/bin/lux-server -a '--start --config /var/www/config.lua'

# uninstall - Uninstalls lux and any init files.  Leave the wwwroot alone for now.
uninstall: filesystem-uninstall $(INITMETHOD)-uninstall wwwroot-uninstall
	@printf '' > /dev/null

# filesystem-uninstall - Uninstalls lux and any init files.  Leave the wwwroot alone for now.
filesystem-uninstall: $(INITMETHOD)-uninstall wwwroot-uninstall
	rm -f $(exec_prefix)/bin/lxcli
	rm -f $(exec_prefix)/bin/lxsrv
	rm -f $(exec_prefix)/bin/lxpkg
	rm -f $(exec_prefix)/bin/lxconf
	rm -rf $(DATADIR)/
	rm -rf $(CONFDIR)/
	rm -rf $(LOGDIR)/

# none-uninstall - Uninstalls (you guessed it) nothing
none-uninstall:

# systemd-uninstall - Uninstalls (you guessed it) nothing
systemd-uninstall:
	rm -f $(SVCPATH)/$(BINNAME).service

# wwwroot-uninstall - Uninstalls (you guessed it) nothing
wwwroot-uninstall:
	echo '$(WWWROOT) must be removed manually.'

# examples - Runs lux with the files in example/.  Use -e PORT to change port number.
examples: PORT=2222
examples: main
	@clear
	@lua -e "a=loadfile( 'example/config.lua' )(); \
		hosts = {}; for k,v in pairs(a.hosts) do table.insert( hosts, 'http://' .. k ) end; \
		print( 'Hosts at example/config.lua are:\n' .. table.concat( hosts, '\n' ) );"
	@printf "Starting lux server, and listening for requests at port 2222...\n"
	@$(srcdir)/bin/$(BINNAME)-server \
		--start \
		--logfile /dev/stderr \
		--accessfile /dev/stderr \
		--port $(PORT) \
		--user $$USER \
		--group $$USER \
		--configuration $(srcdir)/example/config.lua

# vendor/sqlite3.o - Build SQLite from our local copy
vendor/sqlite3.o: CFLAGS+=-Wno-misleading-indentation -Wno-deprecated-declarations
vendor/sqlite3.o:
	$(CC) $(CFLAGS) -c -o vendor/sqlite3.o vendor/sqlite3.c

# vendor/liblua.a - Build Lua 5.4.4 statically
lib/liblua.a: 
	-@mkdir $(srcdir)/lib/ $(srcdir)/include/
	-@cd vendor/lua-$(LUAVER) && \
		make MYCFLAGS="-fPIC" -e TMPDIR=/tmp && \
		make install INSTALL_TOP=../../.. INSTALL_MAN=/tmp INSTALL_BIN=/tmp && \
		rm -f /tmp/lua.1 /tmp/luac.1 /tmp/lua /tmp/luac

# vendor/gnutls.a - Build GnuTLS 3.6.x statically
lib/libgnutls.a: 
	-@mkdir $(srcdir)/lib/ $(srcdir)/include/
	-@cd vendor/ && \
		cd gnutls-$(GNUTLSVER) && \
		./configure --prefix=`readlink -f ../../` --disable-guile --enable-static && \
		make && \
		make install

# clean - Get rid of object files and tests 
clean:
	-@find $(srcdir)/src/ -maxdepth 2 -type f -name "*.o" | xargs rm
	-@find $(srcdir)/bin/ -maxdepth 1 -type f | xargs rm
	-@find $(srcdir)/vendor/ -type f -name "*.o" | xargs rm

# clean - Get rid of object files, tests and external dependencies
veryclean: clean
	-@rm -rf $(srcdir)/lib/
	-@rm -rf $(srcdir)/include/

# pristine - Run 'clean', 'veryclean' and get rid of autoconf files as well
pristine: clean veryclean
	-@rm -rf autom4te.cache config.guess config.log config.status config.sub configure Makefile

# list - List all the targets and what they do
list:
	@printf 'Available options are:\n'
	@sed -n '/^# / { s/# //; 1d; p; }' Makefile | awk -F '-' '{ printf "  %-20s - %s\n", $$1, $$2 }'

Makefile: Makefile.in config.status
	./config.status $@

config.status: configure
	./config.status --recheck

# Include documentation recipes
include mk/docs.mk

# Include www documentation recipes
-include mk/docswww.mk

# Include packaging recipes
-include mk/pkg.mk

# Include test recipes
include mk/tests.mk

# Include local build targets 
-include mk/local.mk

.PHONY: check clean dist distcheck docs install test tests bugs 
